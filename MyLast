#!/bin/bash

b="/var/log/wtmp"
fl=1
n=-1

while [[ $# > 0 ]]; do
    case $1 in
    -b)
        fl=0
        b="/var/log/btmp"
        shift
        ;;
    -n)
        shift
        n="$1"
        shift
        ;;
    esac
done

count=0
timp_prec=-1
./inputParse "$b" | while IFS= read -r linie; do
    IFS=',' read -r f user line host timp durata <<< "$linie"
    if [[ $fl == 1 && $f == 0 || $user == "" ]]; then
        continue
    fi
    ((count++))
    if [[ "$n" -ge 0 && "$count" -gt "$n" ]]; then
        break
    fi
    if [[ $line == "~" ]]; then
        line="system boot"
        if [[ $timp_prec < 0 ]]; then
            timp_prec=$timp
        fi
    fi
    if [[ $timp_prec < 0 ]]; then
        durata="still logged in"
    else
        durata=$((timp_prec-timp))
        durata=$(printf "%d:%02d:%02d" $((durata / 3600)) $((durata / 60 % 60)) $((durata % 60)))
        timp_prec=$timp
    fi
    timp=$(date -d "@$timp" +"%d.%m.%y %H:%M")
    printf "%-10s | %-12s | %-15s | %-10s | %-10s\n" "$user" "$line" "$host" "$timp" "$durata" 
done
